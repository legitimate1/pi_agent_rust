equest-builder */\n  427→  private buildPiRequest(\n  428→    id: string,\n  429→    type: string,\n  430→    data?: Record<string, unknown>,\n  431→  ): Record<string, unknown> {\n  432→    return buildReq(id, type, data);\n  433→  }\n  434→\n  435→  // ============================================================\n  436→  // init 处理\n  437→  // ============================================================\n  438→\n  439→  private async handleInit(\n  440→    data?: Record<string, unknown>,\n  441→  ): Promise<PiRpcEvent> {\n  442→    console.log(\"[Pi] 会话已就绪\");\n  443→    return {\n  444→      type: \"ready\" as const,\n  445→      data: { initialized: true, extensionCount: 0, skillCount: 0 },\n  446→    };\n  447→  }\n  448→\n  449→  // ============================================================\n  450→  // pi 事件处理\n  451→  // ============================================================\n  452→\n  453→    private handlePiEvent(event: Record<string, unknown>): void {\n  454→      // extension_ui_request — 扩展宿主调用请求\n  455→      if (event.type === \"extension_ui_request\") {\n  456→        const method = event.method as string;\n  457→\n  458→        if (method === \"notify\") {\n  459→          // fire-and-forget: 缓冲 + emit 用于实时消息显示\n  460→          const msg = typeof event.message === \"string\" ? event.message : \"\";\n  461→          if (msg && this.activePromptId) {\n  462→            this.stdoutBuffer.push(msg);\n  463→          }\n  464→          if (msg) {\n  465→            this.emit({\n  466→              type: \"ext_output\",\n  467→              data: { message: msg },\n  468→            } as PiRpcEvent);\n  469→          }\n  470→          return;\n  471→        }\n  472→\n  473→        // 只对已知交互方法分派 ext_interactive\n  474→        const KNOWN_INTERACTIVE = [\"select\", \"confirm\", \"input\", \"editor\"];\n  475→        if (KNOWN_INTERACTIVE.includes(method)) {\n  476→          this.emit({\n  477→            type: \"ext_interactive\",\n  478→           