            : undefined,\n  307→          });\n  308→\n  309→          for (const [, { reject }] of this.pendingResolve) {\n  310→            reject(new Error(`Pi 进程已退出 (code=${code})`));\n  311→          }\n  312→          this.pendingResolve.clear();\n  313→        });\n  314→\n  315→        this.child.on(\"error\", (err) => {\n  316→          console.error(`[Pi] Error:`, err);\n  317→          this.setStatus({ state: \"error\", lastError: err.message });\n  318→          reject(err);\n  319→        });\n  320→\n  321→        // 不等待任何输出，立即 resolve——pi 在后台慢慢初始化\n  322→        // 后续请求（get_state/prompt 等）会被排队，pi 初始化完成后再处理\n  323→        resolve();\n  324→      } catch (err) {\n  325→        this.setStatus({\n  326→          state: \"error\",\n  327→          lastError: err instanceof Error ? err.message : String(err),\n  328→        });\n  329→        reject(err);\n  330→      }\n  331→    });\n  332→  }\n  333→\n  334→  async stop(): Promise<void> {\n  335→    this.shuttingDown = true;\n  336→    if (!this.child) return;\n  337→\n  338→    return new Promise<void>((resolve) => {\n  339→      const timeout = setTimeout(() => {\n  340→        this.forceKill();\n  341→        resolve();\n  342→      }, 3000);\n  343→      this.child!.on(\"exit\", () => {\n  344→        clearTimeout(timeout);\n  345→        resolve();\n  346→      });\n  347→      this.child!.kill();\n  348→    }).finally(() => {\n  349→      this.setStatus({ state: \"disconnected\" });\n  350→    });\n  351→  }\n  352→  /** 获取并清空 stdout 缓冲区（扩展命令的 notify 输出，由 sendRawPrompt 消费） */\n  353→  drainStdoutBuffer(): string {\n  354→    const content = this.stdoutBuffer.join(\"\\n\\n\");\n  355→    this.stdoutBuffer = [];\n  356→    return content;\n  357→  }\n  358→\n  359→  private forceKill(): void {\n  360→    if (!this.child) return;\n  361→    try {\n  362→      if (process.platform === \"win32\") {\n  363→        spawn(\"taskkill\", [\"/pid\", String(this.child.pid), \"/T\", \"/F\"]);\n  364→      } else