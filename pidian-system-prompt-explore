→    return () => this.statusListeners.delete(callback);\n  151→  }\n  152→\n  153→  // ============================================================\n  154→  // 生命周期\n  155→  // ============================================================\n  156→\n  157→  async start(\n  158→    cwd: string,\n  159→    disabledExtensions?: string[],\n  160→    sessionPath?: string,\n  161→    /** 以指定模型启动（--model provider/id），不写 settings.json */\n  162→    model?: string,\n  163→    /** 以指定思考等级启动（--thinking level） */\n  164→    thinkingLevel?: string,\n  165→    /** 以指定文件覆盖 system prompt（--system-prompt <path>） */\n  166→    systemPromptPath?: string,\n  167→    /** 额外 CLI 参数（如 --no-tools --no-skills），直接追加到 pi 启动参数 */\n  168→    extraArgs?: string[],\n  169→  ): Promise<void> {\n  170→    if (this.child) await this.stop();\n  171→    this.shuttingDown = false;\n  172→    const freshPath = await getFreshPathAsync();\n  173→    return this.doStart(cwd, disabledExtensions, sessionPath, model, thinkingLevel, freshPath, systemPromptPath, extraArgs);\n  174→  }\n  175→\n  176→  /**\n  177→   * 构建扩展加载参数：--no-extensions + 显式 -e 每个要加载的扩展\n  178→   * 避免禁用扩展仍然被加载（替代临时修改 settings.json）\n  179→   */\n  180→  private buildExtensionArgs(disabledExts: string[]): string[] {\n  181→    const args: string[] = [];\n  182→\n  183→    // 扫描扩展目录，收集所有可用扩展\n  184→    let extDirs: string[] = [];\n  185→    try {\n  186→      extDirs = fs.readdirSync(EXTENSIONS_DIR, { withFileTypes: true })\n  187→        .filter((d) => d.isDirectory() && !d.name.startsWith(\"_\"))\n  188→        .map((d) => d.name)\n  189→        .sort();\n  190→    } catch {\n  191→      return args; // 没有扩展目录，返回空\n  192→    }\n  193→\n  194→    // 过滤掉被禁用的扩展\n  195→    const enabledExts = extDirs.filter(\n  196→      (name) => !disabledExts.includes(name),\n  197→    );\n  198→    if (enabledExts.length === extDirs.length) {\n  199→      return args; // 没有禁用任何扩展，走自动发现\n  200→    }\n  201→\n  202→    // 使用 --no-extensions 禁用自动发现，再用 -e 显式加载\n  203→    args.push(\"--no-extensions\");\n  204→    for (const name of enabledExts) {\n  205→      const extPath = path.join(EXTENSIONS_DIR, name, \"index.ts\");\n  206→      if (fs.existsSync(extPath)) {\n  207→        args.push(\"-e\", extPath);\n  208→      }\n  209→    }\n  210→    return args;\n  211→  }\n  212→\n  213→  private doStart(\n  214→    cwd: string,\n  215→    disabledExtensions?: string[],\n  216→    sessionPath?: string,\n  217→    model?: string,\n  218→    thinkingLevel?: string,\n  219→    freshPath?: string,\n  220→    systemPromptPath?: string,\n  221→    extraArgs?: string[],\n  222→  ): Promise<void> {\n  223→    return new Promise((resolve, reject) => {\n  224→      try {\n  225→        const extArgs = disabledExtensions?.length\n  226→          ? this.buildExtensionArgs(disabledExtensions)\n  227→          : [];\n  228→        const piArgs = [\"--mode\", \"rpc\", ...extArgs, ...(extraArgs ?? [])];\n  229→        if (sessionPath) {\n  230→          piArgs.push(\"--session\", sessionPath);\n  231→        }\n  232→        if (model) {\n  233→          piArgs.push(\"--model\", model);\n  234→        }\n  235→        if (thinkingLevel) {\n  236→          piArgs.push(\"--thinking\", thinkingLevel);\n  237→        }\n  238→        if (systemPromptPath) {\n  239→          piArgs.push(\"--system-prompt\", systemPromptPath);\n  240→        }\n  241→        console.log(`[Pi] Spawning: ${PI_PATH} ${piArgs.join(\" \")}`);\n  242→        this.setStatus({ state: \"connecting\" });\n  243→\n  244→        this.child = spawn(PI_PATH, piArgs, {\n  245→          cwd,\n  246→          stdio: [\"pipe\", \"pipe\", \"pipe\"],\n  247→          windowsHide: true,\n  248→          env: freshPath\n  249→            ? { ...process.env, PATH: freshPath }\n  250→            : undefined,\n  251→        });\n  252→\n  253→        this.setStatus({ pid: this.child.pid ?? undefined });\n  254→\n  255→        // stdout → JSONL 事件处理\n  256→        this.rl = createInterface({\